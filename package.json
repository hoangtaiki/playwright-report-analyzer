{
  "name": "playwright-report-analyzer",
  "version": "0.1.0",
  "description": "Parse a Playwright JSON test report for a trustworthy total/passed/failed/flaky/skipped summary and the tests still failing, with retries, multi-project runs and merged reruns handled correctly",
  "keywords": [
    "playwright",
    "testing",
    "qa",
    "automation",
    "ci",
    "test-report",
    "json-reporter",
    "test-summary",
    "failed-tests",
    "flaky-tests",
    "typescript",
    "test-automation",
    "e2e-testing",
    "test-framework"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "playwright-report-analyzer": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:coverage": "playwright test --reporter=html",
    "clean": "rm -rf dist test-results playwright-report coverage .tmp-reports",
    "prepare": "husky && npm run build",
    "prepublishOnly": "npm run clean && npm run build && npm run test",
    "lint": "eslint src tests report-src",
    "lint:fix": "eslint src tests report-src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "coverage": "c8 playwright test",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "release": "semantic-release"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoangtaiki/playwright-report-analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/hoangtaiki/playwright-report-analyzer/issues"
  },
  "homepage": "https://github.com/hoangtaiki/playwright-report-analyzer#readme",
  "author": "Harry Tran <duchoang.vp@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.{ts,js,css,md}": "prettier --write",
    "*.{ts,js}": "eslint --cache --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.1.1",
    "c8": "^12.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.2.5",
    "semantic-release": "^25.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0"
  }
}
